# Copy to .env to override defaults. Without this file the backend runs on
# a local sqlite database (zero setup), which is fine for development.

# For Postgres (matches docker-compose):
# DATABASE_URL=postgresql://taskboard:taskboard@localhost:5432/taskboard

JWT_SECRET=change-me-in-production
CORS_ORIGINS=http://localhost:5173
REDIS_URL=redis://localhost:6379/0
